{
    "builds": [
        {
            "src": "run_server.py",
            "use": "@vercel/python"
        },
        {
            "src": "dashboard.html",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "handle": "filesystem"
        },
        {
            "src": "/",
            "dest": "/dashboard.html"
        },
        {
            "src": "/api/(.*)",
            "dest": "run_server.py"
        }
    ]
}
