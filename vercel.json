{
    "regions": ["sin1"],
    "builds": [
        {
            "src": "run_server.py",
            "use": "@vercel/python"
        },
        {
            "src": "package.json",
            "use": "@vercel/static-build",
            "config": {"distDir": "public"}
        }
    ],
    "routes": [
        {
            "handle": "filesystem"
        },
        {
            "src": "/",
            "dest": "/dashboard.html"
        },
        {
            "src": "/api/(.*)",
            "dest": "run_server.py"
        }
    ]
}
